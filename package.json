{
  "name": "hyperbay",
  "version": "0.1.0",
  "description": "Decentralized, self-hosted bay for open-source model weights. P2P catalog on Autobase, bytes on Hyperdrive, discovery on Hyperswarm.",
  "main": "ui/index.html",
  "type": "commonjs",
  "bin": {
    "hyperbay": "./bin/hyperbay.js"
  },
  "pear": {
    "name": "hyperbay",
    "type": "desktop",
    "gui": {
      "backgroundColor": "#0b0f14",
      "height": 900,
      "width": 1400
    }
  },
  "engines": {
    "bare": ">=1.30.0"
  },
  "scripts": {
    "start": "bare bin/hyperbay.js serve",
    "test": "bare test/all.js",
    "app": "pear run --dev .",
    "lint": "biome check ."
  },
  "dependencies": {
    "autobase": "^7.28.2",
    "b4a": "^1.9.0",
    "bare-events": "^2.9.2",
    "bare-fetch": "^3.4.0",
    "bare-fs": "^4.8.1",
    "bare-http1": "^4.6.2",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.2",
    "bare-process": "^4.5.1",
    "bare-stream": "^2.13.4",
    "bare-subprocess": "^6.1.0",
    "bare-url": "^2.5.4",
    "corestore": "^7.12.5",
    "graceful-goodbye": "^1.3.3",
    "hyperbee": "^2.27.3",
    "hypercore-crypto": "^3.7.0",
    "hypercore-id-encoding": "^1.3.0",
    "hyperdrive": "^13.3.3",
    "hyperswarm": "^4.17.1",
    "localdrive": "^2.2.1",
    "mirror-drive": "^1.14.2",
    "protomux-wakeup": "^2.9.0",
    "ready-resource": "^1.2.0",
    "sodium-universal": "^5.0.1",
    "streamx": "^2.28.1",
    "which-runtime": "^1.4.0",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "brittle": "^4.2.0"
  },
  "license": "MIT"
}
